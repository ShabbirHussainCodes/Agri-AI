      "ActivitySummary": {
        "additionalProperties": false,
        "description": "`details` is a JSON string, not a nested object: Groq's strict\nschema mode requires every object field to list fixed `properties`\n(verified against console.groq.com/docs/structured-outputs,\n2026-09-03) -- it does not support an open, arbitrary-key dict like\nactivities.details actually is (irrigation vs fertiliser vs spray\neach have different fields). This field is read-only evidence shown\nto the model, never written back, so a JSON string is sufficient and\nkeeps the schema valid without inventing a fixed shape that doesn't\nexist yet.",
        "properties": {
          "details": {
            "title": "Details",
            "type": "string"
          },
          "occurred_on": {
            "format": "date",
            "title": "Occurred On",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "occurred_on",
          "details"
        ],
        "title": "ActivitySummary",
        "type": "object"
      },
      "AdvisoryRecord": {
        "description": "A saved answer. `response` is the AdvisoryResponse exactly as it was when\nthe farmer received it, kept as a plain object on purpose: that contract\ngrows, and an old row must never fail to load because of a newer schema.",
