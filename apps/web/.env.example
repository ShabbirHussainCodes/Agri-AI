# Copy to .env.local for development. NEXT_PUBLIC_* values are inlined into the browser
# bundle at BUILD time and are public: only ever put the anon (publishable) key here, never a
# service-role key or any other secret.
# Leave this unset (off) until the Hindi answers were measured: docs/ai/ui-language-hint.md
# NEXT_PUBLIC_SEND_UI_LANGUAGE=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key-from-supabase-status
