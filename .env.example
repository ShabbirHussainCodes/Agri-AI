# AgriAI — environment configuration TEMPLATE
# Copy to `.env` and fill with your OWN values. NEVER commit real secrets.
# All AgriAI variables are namespaced AGRIAI_* so they can never be confused
# with the separate BillingMars project's credentials.

# ============================================================
# Core
# ============================================================
AGRIAI_ENV=development                     # development | production
AGRIAI_API_BASE_URL=http://localhost:8000
AGRIAI_WEB_BASE_URL=http://localhost:3000

# ============================================================
# Supabase  (AgriAI's OWN project "agriai-db", region ap-south-1)
#   Do NOT put BillingMars credentials here.
# ============================================================
AGRIAI_SUPABASE_URL=https://<your-agriai-project-ref>.supabase.co
AGRIAI_SUPABASE_ANON_KEY=<anon-public-key>            # safe for the browser (RLS enforced)
AGRIAI_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # SERVER ONLY — never ship to the frontend
AGRIAI_SUPABASE_JWT_JWKS_URL=https://<your-agriai-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
AGRIAI_DATABASE_URL=postgresql://postgres:<db-password>@db.<ref>.supabase.co:5432/postgres

# Local dev database (docker-compose Postgres+pgvector) — used instead of Supabase in dev
AGRIAI_LOCAL_DATABASE_URL=postgresql://agriai:agriai@localhost:5432/agriai

# ============================================================
# LLM / AI providers  (behind the provider abstraction)
# ============================================================
AGRIAI_GROQ_API_KEY=<groq-api-key>
AGRIAI_GROQ_CHAT_MODEL=openai/gpt-oss-120b
AGRIAI_GROQ_CHAT_MODEL_FAST=openai/gpt-oss-20b
AGRIAI_GROQ_VISION_MODEL=qwen/qwen3.6-27b
AGRIAI_GROQ_STT_MODEL=whisper-large-v3-turbo

# Fallback provider (training opt-out must be enabled in the Mistral console)
AGRIAI_MISTRAL_API_KEY=<mistral-api-key>

# ============================================================
# External data APIs
# ============================================================
# Open-Meteo needs no key. Register your OWN data.gov.in key (do not reuse demo keys).
AGRIAI_DATAGOVIN_API_KEY=<your-data-gov-in-key>
# SoilGrids: public REST, no key. Nominatim: no key, but set a valid contact UA.
AGRIAI_NOMINATIM_USER_AGENT=AgriAI/0.x (contact: you@example.com)

# ============================================================
# Storage  (Supabase Storage for MVP, behind StorageProvider)
# ============================================================
AGRIAI_STORAGE_PROVIDER=supabase           # supabase | r2  (r2 only if constraints justify)
AGRIAI_STORAGE_BUCKET=crop-photos

# ============================================================
# Notifications
# ============================================================
AGRIAI_VAPID_PUBLIC_KEY=<web-push-vapid-public>
AGRIAI_VAPID_PRIVATE_KEY=<web-push-vapid-private>
AGRIAI_VAPID_SUBJECT=mailto:you@example.com

# ============================================================
# Observability
# ============================================================
AGRIAI_LANGFUSE_PUBLIC_KEY=<langfuse-public>
AGRIAI_LANGFUSE_SECRET_KEY=<langfuse-secret>
AGRIAI_LANGFUSE_HOST=https://cloud.langfuse.com
AGRIAI_SENTRY_DSN=<sentry-dsn>             # optional

# ============================================================
# Safety data
# ============================================================
AGRIAI_AGROCHEM_TABLE_VERSION=            # e.g. cibrc-major-uses-2025-08 ; stamped at ingest
